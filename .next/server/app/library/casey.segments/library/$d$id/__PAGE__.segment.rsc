0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"book":{"id":"casey","title":"Digital Evidence and Computer Crime","authors":"Eoghan Casey","publisher":"Academic Press / Elsevier","year":"3rd edition · 2011","color":"slate","code":"EVIDENCE / SCIENTIFIC METHOD","url":"https://shop.elsevier.com/books/digital-evidence-and-computer-crime/casey/978-0-08-092148-8","description":"A foundational text on forensic science, digital investigation, offender analysis, and network evidence. Especially valuable for learning to reason from artifacts rather than merely operate software.","editionNote":"The route below follows the third edition’s verified early chapters and major subject areas; it is not a complete publisher TOC. The US and European legal chapters require current Indian-law supplementation.","chapters":[{"title":"1. Foundations of Digital Forensics","summary":"Define digital evidence, core principles, the cybertrail, and the challenges of applying forensic science to changing technology.","topics":["2.4","3.7"]},{"title":"2. Language of Computer Crime Investigation","summary":"Build a precise vocabulary for systems, roles, and the relationship between computers and crime.","topics":["1.1","1.5"]},{"title":"3. Digital Evidence in the Courtroom","summary":"Study expert duties, admissibility, certainty, circumstantial evidence, and presentation.","topics":["2.9","4.10","4.12"]},{"title":"4–5. Cybercrime Law","summary":"Compare the book’s US and European legal discussions, then identify the corresponding Indian questions without assuming equivalence.","topics":["1.3","1.12"]},{"title":"6. Conducting Digital Investigations","summary":"Use process models, investigative scaffolding, and the scientific method to organize a case.","topics":["2.2","3.7"]},{"title":"7. Handling a Digital Crime Scene","summary":"Study authorization, preparation, survey, and preservation. Apply the concepts through the acquisition simulation.","topics":["2.3","2.6"]},{"title":"8. Investigative Reconstruction with Digital Evidence","summary":"Evaluate equivocal artifacts, victimology, scene characteristics, and threshold assessments.","topics":["4.7","4.11"]},{"title":"9. Modus Operandi, Motive, and Technology","summary":"Connect modus operandi and motive to technical choices while keeping inference separate from observation.","topics":["3.7","5.3"]},{"title":"10. Violent Crime and Digital Evidence","summary":"Examine the role of digital traces in serious-crime reconstruction and the need for careful interpretation.","topics":["2.5","4.11"]},{"title":"11. Digital Evidence as Alibi","summary":"Test time-based claims and alternative explanations rather than assuming every account event identifies a person.","topics":["2.4","4.7"]},{"title":"Computer-system examination","summary":"Read the operating-system and device chapters relevant to your evidence source. Preserve format, timestamp, and application context.","topics":["3.8","3.10","4.5"]},{"title":"Network and internet evidence","summary":"Connect the book’s network-layer discussions to current packet, flow, cloud, and provider evidence. Update older tool assumptions.","topics":["3.9","3.12","4.8"]}]}}],[["$","script","script-0",{"src":"/_next/static/chunks/00ecls70la0ay.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
