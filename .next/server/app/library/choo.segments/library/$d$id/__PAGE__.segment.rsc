0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"book":{"id":"choo","title":"Cyber and Digital Forensic Investigations","authors":"Edited by Nhien-An Le-Khac & Kim-Kwang Raymond Choo","publisher":"Springer · Studies in Big Data 74","year":"2020","color":"teal","code":"LAW ENFORCEMENT / PRACTICE","url":"https://link.springer.com/book/10.1007/978-3-030-47131-6","description":"A practitioner-oriented collection spanning IoT, ransomware, CCTV, financial accounts, cloud services, mobile networks, Tor, and Bitcoin. Read it as a set of specialist investigations rather than a single universal procedure.","editionNote":"The publisher lists 12 chapters. Some editions combine related ransomware or PayPal chapters in their display; use the chapter titles in your own copy. This guide uses ten study sections covering those subjects.","chapters":[{"title":"1. The Increasing Importance of Digital Forensics and Investigations","summary":"Frame the growing role of digital evidence in law enforcement, government, and commercial investigations.","topics":["2.1","2.5"]},{"title":"2. Defending IoT Devices from Malware","summary":"Map device constraints, attack surfaces, and defensive evidence sources in connected environments.","topics":["3.8","5.7"]},{"title":"3. Digital Forensic Investigation of Internet of Thing Devices","summary":"Use a model-based approach to identify evidence across devices, companion applications, and services.","topics":["2.5","3.10"]},{"title":"4–5. Forensic Investigation of Ransomware Activities","summary":"Connect incident stages, artifacts, and response decisions. Separate containment from proof of initial access or actor identity.","topics":["3.8","4.7","5.3"]},{"title":"6. CCTV Forensics in the Big Data Era","summary":"Consider time accuracy, video provenance, scale, and interpretation. A visible person or event still needs contextual verification.","topics":["2.4","2.6"]},{"title":"7. Forensic Investigation of PayPal Accounts","summary":"Study financial-account records and the link between account control, transactions, and external corroboration. Platform interfaces and policies change.","topics":["2.5","3.11"]},{"title":"8. Digital Forensic Approaches for Cloud Service Models","summary":"Compare evidence control in IaaS, PaaS, and SaaS. Build a tenant-and-provider source matrix before requesting acquisition.","topics":["3.12","2.12"]},{"title":"9. LTE Network Security and Real-Time Data Extraction","summary":"Understand the specialist network context and distinguish research extraction methods from authorized forensic practice.","topics":["3.9","3.10"]},{"title":"10. Towards an Automated Process to Categorise Tor’s Hidden Services","summary":"Evaluate automated classification, dataset limits, and the difference between a category prediction and an evidential finding.","topics":["3.6","5.11"]},{"title":"11–12. The Bitcoin-Network Protocol from a Forensic Perspective; What Next?","summary":"Study public ledger observations and future directions. Address clustering does not by itself establish the human controller or criminal purpose.","topics":["3.6","5.12"]}]}}],[["$","script","script-0",{"src":"/_next/static/chunks/00ecls70la0ay.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
