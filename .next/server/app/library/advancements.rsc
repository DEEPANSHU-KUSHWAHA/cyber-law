5:["$","$L10",null,{"book":{"id":"advancements","title":"Advancements in Cybercrime Investigation and Digital Forensics","authors":"Edited by Chandra Singh, Amarnath Mishra & A. Harisha","publisher":"Apple Academic Press / CRC Press","year":"2024 copyright · published 2023","color":"ochre","code":"METHODS / MACHINE LEARNING","url":"https://www.routledge.com/Advancements-in-Cybercrime-Investigation-and-Digital-Forensics/Harisha-Mishra-Singh/p/book/9781774913031","description":"An 18-chapter research collection connecting Indian investigation challenges with recovery, mobile evidence, dark-web analysis, machine learning, and AI-assisted forensics.","editionNote":"Chapter order follows the publisher’s listing. The study explanations are original. Evaluate research methods and datasets rather than treating every reported result as operationally validated.","chapters":[{"title":"1. Challenges to Cybercrime Reporting, Investigation, and Adjudication in India","summary":"Identify reporting, first-response, agency, technical, and jurisdictional barriers, then supplement the legal discussion with the post-2024 framework.","topics":["2.1","2.12"]},{"title":"2. A Comprehensive Review on Digital Forensics Intelligence","summary":"Connect forensic examination with intelligence requirements and cross-source evaluation.","topics":["3.7","5.1"]},{"title":"3. Security Mechanisms for Information Protection and Transmission over Open Networks","summary":"Review protection mechanisms and the traces they create or limit in network investigation.","topics":["3.9","4.8"]},{"title":"4. Wearable Devices and Forensic Investigation","summary":"Map wearable, companion-app, and cloud evidence, including synchronization and location uncertainty.","topics":["2.5","3.10"]},{"title":"5. Combating Cybercrimes with Digital Forensics","summary":"Connect investigative method to the legal and operational context of a case.","topics":["2.2","3.7"]},{"title":"6. Clustering and Classification of Digital Forensic Data","summary":"Study machine-learning and data-mining approaches, feature choices, and evaluation limits.","topics":["5.9","5.11"]},{"title":"7. Digital Forensic Investigation: Ontology, Methodology, and Technological Advancement","summary":"Examine process models and how tools fit a defensible investigative method.","topics":["3.7","4.1"]},{"title":"8. Data Breach Fraudulence and Preventive Measures in E-Commerce Platforms","summary":"Trace breach and fraud pathways through accounts, transactions, and platform controls.","topics":["1.5","5.7"]},{"title":"9. An Approach to Data Recovery from Solid State Drive","summary":"Focus on flash behavior, TRIM, and why deleted-data recovery is conditional.","topics":["2.7","4.6"]},{"title":"10. A Critical Analysis of the Dark Side of the Dark Web","summary":"Evaluate dark-web evidence and investigative boundaries without equating anonymity with crime.","topics":["3.6"]},{"title":"11. Tools and Protocols for the Analysis of Mobile Phones","summary":"Compare mobile extraction methods, application formats, and tool limitations.","topics":["3.10","4.3"]},{"title":"12. Tree-Based Machine Learning for Credit Card Fraud Detection","summary":"Examine classification, class imbalance, and the operational cost of false positives.","topics":["5.9","5.11"]},{"title":"13. Black Hats: A Major Threat to Your Finances","summary":"Connect financial cybercrime patterns with victim protection and payment verification.","topics":["1.5","3.11"]},{"title":"14. Enhanced Security Based on Face Detection in Payment Gateway","summary":"Study biometric authentication as a control, including error and spoofing considerations.","topics":["5.7","5.8"]},{"title":"15. Artificial Intelligence Applied to Computer Forensics","summary":"Assess assistance, validation, explainability, and the examiner’s continuing responsibility.","topics":["5.10","5.11"]},{"title":"16. OAuth 2.0 Defenses and Working Using Digital Signatures","summary":"Distinguish authorization from authentication and examine trust boundaries in token-based systems.","topics":["3.12","5.3"]},{"title":"17. Child Pornography: The Filth of Society","summary":"Approach the legal and safeguarding context with victim-centered handling. This course contains no exploitative material or acquisition guidance.","topics":["1.6","2.12"]},{"title":"18. Digital Forensics and Cybersecurity Tools","summary":"Create a task-based tool inventory and evaluate versions, validation, and reporting needs.","topics":["4.1","4.2","4.9"]}]}}]
