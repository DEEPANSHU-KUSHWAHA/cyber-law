0:{"rsc":["$","$1","c",{"children":[[["$","$L2","bsa",{"law":{"id":"bsa","title":"Bharatiya Sakshya Adhiniyam, 2023","short":"BSA","year":"2023 · in force 1 July 2024","kind":"Act","status":"current","summary":"The law of evidence, including electronic records and the current two-part certificate in the Schedule.","url":"https://www.mha.gov.in/sites/default/files/2024-04/250882_english_01042024_0.pdf","caution":"Section 63 is not a renamed section 65B. Use the Schedule, Part A and Part B, and the applicable current text.","topics":["2.10","2.9","4.12"],"sections":[{"number":"39","title":"Opinions of experts","text":"Addresses opinions of persons specially skilled in relevant fields, including science or art. The underlying facts, qualifications, method, and limits remain open to evaluation; compare old Evidence Act section 45."},{"number":"57","title":"Documentary evidence","text":"Includes electronic and digital records within documentary evidence. Read the statutory definitions and the special electronic-proof provisions together."},{"number":"61","title":"Electronic or digital records","text":"Provides legal-recognition language for electronic records, subject to the section’s wording. Legal recognition does not by itself prove authorship, truth, or compliance with section 63."},{"number":"62","title":"Proof of contents of electronic records","text":"Requires contents of electronic records to be proved in accordance with section 63. It broadly corresponds to the old Evidence Act section 65A."},{"number":"63(1)","title":"Computer output deemed a document","text":"Covers qualifying output from computers, communication devices, and electronic or digital storage, subject to the section’s conditions. Identify the actual output being submitted."},{"number":"63(2)","title":"Conditions for electronic output","text":"Addresses regular use and lawful control, ordinary input or derivation, proper operation during the material period, and the relationship between the information and the output. Faults must be assessed for their effect on accuracy."},{"number":"63(3)","title":"Systems, networks, and combinations","text":"Addresses creation, storage, or processing through standalone devices, systems, networks, or combinations. Explain the materially relevant devices rather than assuming only the final display device matters."},{"number":"63(4)","title":"Certificate at each submission","text":"Requires a certificate identifying the record, describing production, giving device particulars, and addressing the conditions, signed by the relevant person in charge and an expert in the Schedule’s form at each instance of submission for admission."},{"number":"Schedule · Part A","title":"Party’s certificate","text":"Identifies the source, device particulars, lawful control, ordinary operation, and hash information. The party must provide truthful particulars and sign the relevant portion; a generic assertion is not a substitute for process knowledge."},{"number":"Schedule · Part B","title":"Expert’s certificate","text":"Addresses the expert, device or source particulars, hash information, and the relevant technical explanation. The expert must actually be able to support the statements made."},{"number":"Schedule · hash report","title":"Integrity documentation","text":"The form calls for hash values and the algorithm, with a hash report attached. Identify exactly which output is hashed. The form lists algorithms; a hash supports integrity, not truth or identity."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],"$L3"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
