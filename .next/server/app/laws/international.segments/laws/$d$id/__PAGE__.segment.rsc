0:{"rsc":["$","$1","c",{"children":[[["$","$L2","international",{"law":{"id":"international","title":"International Law and Cyber Operations","short":"International law","year":"UN Charter and applicable law","kind":"Standard","status":"framework","summary":"A study guide to sovereignty, use of force, armed conflict, and international cooperation in cyber operations.","url":"https://legal.un.org/repertory/art2.shtml","topics":["5.4","5.6"],"sections":[{"number":"UN 2(4)","title":"Threat or use of force","text":"A central reference for interstate force. Whether a cyber operation meets the threshold depends on the circumstances and legal analysis, not merely the label “attack”."},{"number":"UN 51","title":"Self-defence","text":"Addresses the inherent right of individual or collective self-defence if an armed attack occurs, subject to the Charter. The cyber armed-attack threshold is fact-specific and debated."},{"number":"IHL","title":"Distinction, proportionality, precautions","text":"Where international humanitarian law applies, these principles govern relevant conduct. Dual-use infrastructure and indirect effects require careful factual and legal assessment. The Tallinn Manual is commentary, not a treaty."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
