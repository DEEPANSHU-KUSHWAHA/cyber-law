0:{"rsc":["$","$1","c",{"children":[[["$","$L2","dpdp",{"law":{"id":"dpdp","title":"Digital Personal Data Protection Act, 2023","short":"DPDP Act","year":"2023 · check commencement","kind":"Act","status":"current","summary":"A separate framework for digital personal data, consent, notice, fiduciary duties, rights, and enforcement.","url":"https://www.meity.gov.in/data-protection-framework","caution":"Enactment and commencement are distinct. Verify current notifications and rules before stating that every operational duty is in force.","topics":["1.9","5.8"],"sections":[{"number":"3","title":"Application","text":"Covers specified digital personal-data processing within India and outside India in connection with offering goods or services to individuals in India, subject to the Act’s exclusions."},{"number":"4–5","title":"Lawful processing and notice","text":"Addresses consent and specified legitimate uses, with notice requirements. A privacy notice should make the data and purpose understandable rather than merely presenting a checkbox."},{"number":"6","title":"Consent","text":"Consent must satisfy the statutory conditions, including being informed and unambiguous where required, and may be withdrawn. Other lawful bases must be examined separately."},{"number":"8","title":"Data-fiduciary obligations","text":"Addresses responsibility, security safeguards, breach intimation, retention, and related duties under the Act. Check the applicable rules and commencement for operational details."},{"number":"11–14","title":"Rights of Data Principals","text":"Includes information, correction, erasure, grievance redressal, and nomination rights subject to the statutory conditions. These are not unrestricted access to every investigative record."},{"number":"16","title":"Cross-border transfer framework","text":"Provides the Act’s transfer approach, subject to specified restrictions and other applicable laws. It does not itself authorize a criminal investigator to obtain foreign evidence."},{"number":"17","title":"Exemptions","text":"Contains exemptions for specified state functions and other purposes, subject to conditions and notifications. Do not assume every investigation is automatically exempt from every duty."},{"number":"44","title":"Amendments and transition","text":"Read the amendment and repeal provisions with commencement notifications, including the transition affecting IT Act section 43A. Keep the date of the incident and processing visible."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
