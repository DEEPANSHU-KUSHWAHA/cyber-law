0:{"rsc":["$","$1","c",{"children":[[["$","$L2","it-2011",{"law":{"id":"it-2011","title":"Reasonable Security Practices and SPDI Rules, 2011","short":"SPDI Rules","year":"2011","kind":"Rule","status":"current","summary":"The section 43A framework for sensitive personal data or information handled by covered body corporates.","url":"https://www.meity.gov.in/acts-rules-and-policies","caution":"Distinct from the 2011 Intermediaries Guidelines Rules. Check the DPDP Act’s commencement and section 43A repeal transition for the relevant date.","topics":["1.9","2.12"],"sections":[{"number":"1–2","title":"Title, commencement, and scope","text":"Identify the Rules and their connection to section 43A and section 87(2)(ob). Apply them to the covered body corporate and data-processing context."},{"number":"3","title":"Sensitive personal data or information","text":"Lists specified categories including passwords, financial information, health conditions, sexual orientation, medical records, biometric information, and certain records received for processing, subject to definitions and exclusions."},{"number":"4","title":"Privacy policy","text":"Requires publication of a clear and accessible privacy policy covering specified collection, use, disclosure, and security information."},{"number":"5","title":"Collection, consent, purpose, and retention","text":"Addresses lawful purpose, notice, consent, collection necessary for the function, retention limits, review, withdrawal, and grievance contact. Sensitive-data consent has a specified written form."},{"number":"6","title":"Disclosure","text":"Regulates third-party disclosure with permission and specified exceptions, including legally mandated requests. Verify the requester’s authority and document the basis and scope."},{"number":"7","title":"Transfer","text":"Permits transfer subject to the stated necessary-contract or consent conditions and the recipient’s required protection level for sensitive personal data."},{"number":"8","title":"Reasonable security practices","text":"Addresses documented standards, security practices, implementation, and assessment. A named standard is not a guarantee; examine the actual controls and audit evidence."},{"number":"9–10","title":"Grievance officer and final provisions","text":"Provides for a grievance officer and redressal within the stated period, alongside the remaining operative provisions. Maintain a record of complaints and decisions."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
