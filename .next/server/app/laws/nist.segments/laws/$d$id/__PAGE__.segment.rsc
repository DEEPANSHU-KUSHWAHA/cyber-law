0:{"rsc":["$","$1","c",{"children":[[["$","$L2","nist",{"law":{"id":"nist","title":"NIST Cybersecurity and Forensic Guidance","short":"NIST","year":"CSF 2.0 (2024) · IR Rev. 3 (2025)","kind":"Standard","status":"framework","summary":"Voluntary frameworks and technical guidance for risk management, incident response, and forensic integration.","url":"https://www.nist.gov/cyberframework","topics":["1.12","2.2","5.2"],"sections":[{"number":"CSF · Govern","title":"Organizational context and risk strategy","text":"Connect cybersecurity to mission, responsibilities, policy, oversight, and supply-chain risk. Governance is a function, not a separate afterthought."},{"number":"CSF · Identify","title":"Assets, context, and risk assessment","text":"Understand systems, data, dependencies, vulnerabilities, and threats. A source inventory is also valuable for evidence preservation."},{"number":"CSF · Protect / Detect","title":"Safeguards and monitoring","text":"Implement proportionate controls and maintain visibility. Logging and monitoring should be designed before an incident, with privacy and retention in mind."},{"number":"CSF · Respond / Recover","title":"Incident action and restoration","text":"Coordinate analysis, communication, containment, eradication, and recovery. Preserve evidence and verify restored services rather than assuming a rebuild solves every problem."},{"number":"SP 800-86","title":"Forensic integration","text":"Describes collection, examination, analysis, and reporting. It is foundational guidance, not a substitute for Indian statutory authority or admissibility requirements."},{"number":"SP 800-61 Rev. 3","title":"Incident-response recommendations","text":"Updates incident-response guidance around the CSF functions. Use the version appropriate to the organization and document how recommendations are implemented."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
