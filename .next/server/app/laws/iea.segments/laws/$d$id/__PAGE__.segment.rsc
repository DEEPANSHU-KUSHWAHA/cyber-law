0:{"rsc":["$","$1","c",{"children":[[["$","$L2","iea",{"law":{"id":"iea","title":"Indian Evidence Act, 1872","short":"IEA","year":"1872 · historical / saved matters","kind":"Act","status":"historical","summary":"The former evidence framework, including the much-cited section 65B electronic-record certificate.","url":"https://www.indiacode.nic.in/bitstream/123456789/15351/1/iea_1872.pdf","topics":["2.9","2.10"],"sections":[{"number":"45","title":"Expert opinion","text":"The former provision on opinions of persons specially skilled in relevant fields. Compare BSA section 39."},{"number":"65A","title":"Special provisions for electronic records","text":"Directed proof of electronic-record contents through section 65B. Compare BSA section 62."},{"number":"65B(1)–(2)","title":"Electronic output and conditions","text":"The former deeming provision and conditions concerning regular use, lawful control, proper operation, and ordinary-course information. Compare BSA section 63 without assuming identical wording."},{"number":"65B(4)","title":"Certificate","text":"The former certificate identified the output, described production, gave device particulars, and addressed the conditions under a responsible person’s signature. The BSA now prescribes a Schedule and party-plus-expert signatures."},{"number":"Case law","title":"Anvar and Arjun","text":"Anvar emphasized the special proof route; Arjun clarified certification and disapproved Shafhi’s relaxation. Read the holdings with the applicable new statutory text and the distinction between original-device production and output."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
