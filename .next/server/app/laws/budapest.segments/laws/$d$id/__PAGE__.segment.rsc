0:{"rsc":["$","$1","c",{"children":[[["$","$L2","budapest",{"law":{"id":"budapest","title":"Budapest Convention on Cybercrime","short":"ETS No. 185","year":"2001","kind":"Standard","status":"framework","summary":"A treaty framework addressing cybercrime, procedural powers, and international cooperation.","url":"https://www.coe.int/en/web/cybercrime/the-budapest-convention","caution":"Check the treaty depositary for participation. This course does not assume that India is a State Party.","topics":["1.12","3.6"],"sections":[{"number":"2–6","title":"Substantive criminal-law provisions","text":"Addresses illegal access, interception, data and system interference, misuse of devices, and specified forgery and fraud. Domestic implementation determines how obligations operate in a State’s law."},{"number":"16–21","title":"Procedural measures","text":"Includes preservation, production, search and seizure, and specified collection measures under treaty conditions and safeguards. A treaty is not a stand-alone classroom search authorization."},{"number":"23–34","title":"International cooperation","text":"Addresses extradition and mutual assistance mechanisms. Use the competent domestic channel and verify the participating States and applicable instruments."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
