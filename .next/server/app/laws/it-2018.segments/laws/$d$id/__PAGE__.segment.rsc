0:{"rsc":["$","$1","c",{"children":[[["$","$L2","it-2018",{"law":{"id":"it-2018","title":"Intermediaries Guidelines Amendment Rules, 2018","short":"2018 amendment","year":"2018 · historical","kind":"Rule","status":"historical","summary":"The commonly intended “IT Rules, 2018” in this syllabus: an amendment process concerning the 2011 intermediary framework.","url":"https://www.meity.gov.in/acts-rules-and-policies","caution":"A precise citation is essential. Do not confuse a consultation draft, the notified amendment, and the later replacement by the 2021 Rules.","topics":["1.10","1.11"],"sections":[{"number":"Citation","title":"Identify the full instrument","text":"Use the full title and notification details of the Intermediaries Guidelines Amendment Rules, 2018. “IT Rules, 2018” alone is ambiguous and is not a replacement for the Act’s name."},{"number":"Rule 3 context","title":"Due diligence and prohibited content","text":"The amendment concerned the intermediary due-diligence framework. Read the actual notified changes with the 2011 Rules and Shreya Singhal’s interpretation of actual knowledge."},{"number":"Draft vs notification","title":"Legal status of proposals","text":"A draft obligation is not binding merely because it was published for consultation. Record the final text, commencement, and operative conditions before making a compliance claim."},{"number":"Transition","title":"Relationship to the 2021 Rules","text":"The 2021 Rules replaced the 2011 Intermediaries Guidelines framework, subject to their savings and later amendments. This did not by itself repeal the separate SPDI Rules."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
