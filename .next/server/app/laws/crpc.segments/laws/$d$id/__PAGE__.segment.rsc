0:{"rsc":["$","$1","c",{"children":[[["$","$L2","crpc",{"law":{"id":"crpc","title":"Code of Criminal Procedure, 1973","short":"CrPC","year":"1973 · historical / saved matters","kind":"Act","status":"historical","summary":"The former general criminal-procedure code, essential for understanding older cases and saved proceedings.","url":"https://www.indiacode.nic.in/bitstream/123456789/15272/1/the_code_of_criminal_procedure,_1973.pdf","topics":["2.3","1.7"],"sections":[{"number":"91","title":"Production of documents or things","text":"The former power to summon necessary or desirable documents or things. Broadly compare BNSS section 94, including express electronic-record language."},{"number":"154","title":"Information in cognizable cases","text":"The former FIR provision. Compare BNSS section 173 and its electronic-communication, signature, and specified preliminary-enquiry provisions."},{"number":"161","title":"Examination of witnesses","text":"The former police examination framework. Compare BNSS section 180 and preserve the applicable recording and signature safeguards."},{"number":"164","title":"Recording confessions and statements","text":"The former magistrate-recording provision. Compare BNSS section 183, including the exact procedure and warnings."},{"number":"165","title":"Search by police officer","text":"The former search power and recording conditions. Compare BNSS section 185 and the additional audiovisual documentation framework."},{"number":"173","title":"Police report","text":"The former completion-report provision, including further investigation. Compare BNSS section 193; do not confuse CrPC 173 with BNSS 173, which concerns information in cognizable cases."},{"number":"482","title":"Inherent powers","text":"The former High Court inherent-power provision. Broadly compare BNSS section 528."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOu