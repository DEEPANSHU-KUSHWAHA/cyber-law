0:{"rsc":["$","$1","c",{"children":[[["$","$L2","policy-2013",{"law":{"id":"policy-2013","title":"National Cyber Security Policy, 2013","short":"Cyber Security Policy","year":"2013","kind":"Policy","status":"framework","summary":"A national policy framework for a secure cyber ecosystem, capacity building, cooperation, and resilience.","url":"https://www.meity.gov.in/writereaddata/files/downloads/National_cyber_security_policy-2013%281%29.pdf","caution":"Policy is not a penal statute. The syllabus label “National IT Policy, 2013” commonly refers to this document.","topics":["1.8","1.11"],"sections":[{"number":"Vision","title":"Secure and resilient cyberspace","text":"Articulates protection of information and infrastructure, privacy, and confidence in digital activity. Translate the vision into measurable institutional responsibilities."},{"number":"Workforce","title":"Capacity building","text":"Emphasizes development of cybersecurity professionals and skills. A course should connect theoretical knowledge with supervised practical learning."},{"number":"Cooperation","title":"Information sharing and coordination","text":"Encourages collaboration across government, industry, and users. Sharing still requires lawful handling, confidentiality, and appropriate safeguards."},{"number":"Implementation","title":"Institutional and sectoral action","text":"Policy objectives require implementation through institutions, plans, and applicable legal instruments. Do not cite the policy alone as the source of a specific criminal offence."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
