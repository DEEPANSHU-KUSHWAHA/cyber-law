0:{"rsc":["$","$1","c",{"children":[[["$","$L2","it-2009",{"law":{"id":"it-2009","title":"Interception, Monitoring and Decryption Rules, 2009","short":"Interception Rules","year":"2009","kind":"Rule","status":"current","summary":"Procedural safeguards for the exercise of IT Act section 69 powers.","url":"https://www.meity.gov.in/acts-rules-and-policies","topics":["2.3","1.6"],"sections":[{"number":"3","title":"Competent authorization","text":"Directions must issue through the competent authority under the statutory framework. A general investigative need is not a substitute for the required authorization."},{"number":"4–6","title":"Review and oversight","text":"The Rules establish a review mechanism and related safeguards. Record the competent approval, scope, and review process for the actual direction."},{"number":"8–13","title":"Execution and assistance","text":"Addresses service-provider assistance, nodal arrangements, and execution controls. Apply confidentiality, authorized scope, and the specific direction rather than collecting unrelated traffic."},{"number":"Records and safeguards","title":"Documentation, use, and destruction","text":"Read the exact current Rules on records, permitted use, retention, and destruction. Evidence preservation and legal holds require careful coordination; do not assume every ordinary destruction rule overrides a lawful preservation requirement."}]}}]],[["$","script","script-0",{"src":"/_next/static/chunks/0h8rqv9vsrp80.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"mMiCr23A_-Cpk0hZkfT7X"}
